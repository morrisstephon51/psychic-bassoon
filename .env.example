# The Plug AI — environment variables
# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (grant tracker + other server data) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://psychic-bassoon-cam6stef.vercel.app

# --- Grant tracker mutations ---
# The grant status + doc-generation endpoints FAIL CLOSED: if MUTATION_SECRET is
# unset they return 503 and refuse to run. Set BOTH of these to the SAME random
# value. The server checks MUTATION_SECRET; the browser sends
# NEXT_PUBLIC_MUTATION_SECRET as a Bearer token. (NEXT_PUBLIC_* is visible in the
# client bundle, so this is a light gate against drive-by abuse, not real auth.)
MUTATION_SECRET=
NEXT_PUBLIC_MUTATION_SECRET=

# --- Grant doc generation (Groq) ---
# Required for /api/grants/[id]/generate-docs. Free at console.groq.com.
GROQ_API_KEY=

# --- Daily grant deadline scan cron ---
# Protects /api/cron/scan-grants. Any random string.
CRON_SECRET=

# --- Optional: email alerts from the grant deadline scan ---
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
